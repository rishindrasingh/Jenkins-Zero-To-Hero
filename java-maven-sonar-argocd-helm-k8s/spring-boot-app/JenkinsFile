pipeline {
  agent {
    docker {
      image 'rishindra2308/maven-docker-aws-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' // mount Docker socket to access the host's Docker daemon
    }
  }

  environment {
    SONAR_URL = "http://44.204.169.190:9000"
    AWS_REGION = 'us-east-1'
    ECR_REPO_NAME = 'spring-boot-demo'
    ECR_REGISTRY = '977098990740.dkr.ecr.us-east-1.amazonaws.com'
    DOCKER_IMAGE = "${ECR_REGISTRY}/${ECR_REPO_NAME}:${BUILD_NUMBER}"
    GIT_USER_NAME = 'rishindrasingh'
    GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
  }

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'rishindra', url: 'https://github.com/rishindrasingh/Jenkins-Zero-To-Hero.git'
      }
    }
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }
  stage('Static Code Analysis') {
        steps {
          withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
            sh '''
              #!/bin/bash
              cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
              mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}
            '''
          }
        }
      }

    stage('Build and Push Docker Image to ECR') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-ecr-cred', usernameVariable: 'AWS_CREDENTIALS_USR', passwordVariable: 'AWS_CREDENTIALS_PSW')]) {
          dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
            script {
              try {
                sh """
                  #!/bin/bash
                  /usr/local/bin/aws configure set aws_access_key_id ${AWS_CREDENTIALS_USR}
                  /usr/local/bin/aws configure set aws_secret_access_key ${AWS_CREDENTIALS_PSW}
                  /usr/local/bin/aws configure set default.region ${AWS_REGION}
                  /usr/local/bin/aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                  docker build -t ${DOCKER_IMAGE} .
                  docker push ${DOCKER_IMAGE}
                """
              } catch (err) {
                error "ECR build/push failed: ${err}"
              }
            }
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh """
            #!/bin/bash
            set -e
            git config --global --add safe.directory "/var/lib/jenkins/workspace/${JOB_NAME}"
            git config user.email "rishindrasingh23@gmail.com"
            git config user.name "Rishindra Singh"
            sed -i -E 's|(image:.*:)(replaceImageTag)|\\1${BUILD_NUMBER}|' java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git commit -m "Update deployment image to version ${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:testaws
          """
        }
      }
    }
  }

  post {
    success {
      echo '✅ Pipeline completed successfully!'
    }
    failure {
      echo '❌ Pipeline failed. Check logs for details.'
    }
  }
}
